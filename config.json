{
  "providers": {
    "twilio": {
      "enabled": true,
      "secret": "${TWILIO_AUTH_TOKEN}"
    },
    "aws_sns": {
      "enabled": false,
      "region": "us-east-1"
    },
    "vonage": {
      "enabled": false,
      "secret": "${VONAGE_SECRET}"
    },
    "generic": {
      "enabled": false,
      "secret": "${GENERIC_API_KEY}",
      "auth_type": "api_key",
      "id_field": "message_id",
      "sender_field": "from_number",
      "recipient_field": "to_number",
      "body_field": "text"
    }
  }
}
